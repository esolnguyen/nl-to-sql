OPENAI_API_KEY=
ORG_ID=
AGENT_MAX_ITERATIONS=15
DH_ENGINE_TIMEOUT=150
SQL_EXECUTION_TIMEOUT=3
UPPER_LIMIT_QUERY_RETURN_ROWS=50

# Operational / security
# DEBUG=true leaks tracebacks to clients — keep it false in production.
DEBUG=false
# When set, every route except /heartbeat requires header `X-API-Key: <key>`.
# Leave empty to disable auth (local dev only — logs a warning).
API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT_KEY=

# ---- Azure OpenAI (optional) ----
# Set AZURE_API_KEY to route all chat + embedding calls through Azure OpenAI
# instead of public OpenAI. When set, OPENAI_API_KEY is not required.
AZURE_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_API_VERSION=2024-12-01-preview
# Azure embedding deployment name (used for table-ranking embeddings).
EMBEDDING_MODEL=text-embedding-3-large

EXAMPLE_SQL_COLLECTION=my-example-records
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_APPLICATION_TOKEN=

# Dependency-injection wiring (importable Python paths)
API_SERVER=api.nl_to_sql_api.NLToSQLAPI
NL_TO_SQL_DB=databases.mongodb.mongo.MongoDB
VECTOR_STORE=databases.vector.chroma.Chroma
CONTEXT_STORE=services.context_store.context_store.ContextStoreService
DB_SCANNER=services.db_scanner.SqlAlchemyScannerService

MONGODB_URI=mongodb://admin:admin@mongodb:27017
MONGODB_DB_NAME=nltosql
MONGODB_DB_USERNAME=admin
MONGODB_DB_PASSWORD=admin

S3_AWS_ACCESS_KEY_ID=
S3_AWS_SECRET_ACCESS_KEY=
ONLY_STORE_CSV_FILES_LOCALLY=True

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

CORE_PORT=80
